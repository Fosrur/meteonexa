{
  "name": "meteonexa",
  "version": "20.1.1",
  "private": true,
  "description": "MeteoNexa maintenance and release toolchain",
  "scripts": {
    "check": "node tools/static-analysis.mjs",
    "check:syntax": "node tools/static-analysis.mjs --syntax-only",
    "lint:eslint": "eslint \"modules/esm/**/*.mjs\"",
    "bundle:verify": "node tools/esbuild-verify.mjs",
    "check:full": "npm run check && npm run check:workflow-supply-chain && npm run check:graph && npm run check:services && npm run check:di && npm run check:shell && npm run check:final && npm run check:p4 && npm run check:p4:backend && npm run check:p4:css && npm run check:p4:i18n && npm run check:p4:build && npm run check:p5 && npm run check:p6 && npm run check:roadmap-complete && npm run check:radar-v2 && npm run check:layout && npm run check:architecture10 && npm run check:app-shell && npm run check:zero-comments && npm run check:i18n-db && npm run check:maintenance && npm run check:i18n-copy && npm run check:i18n-runtime && npm run check:p2:release && npm run check:release && npm run lint:eslint && npm run bundle:verify && npm run check:php-components && npm run check:10-10",
    "build:assets": "python3 tools/fingerprint_assets.py",
    "build": "npm run check && npm run build:production",
    "qa": "node tools/run-quality.mjs full",
    "check:workflow-supply-chain": "python3 qa/workflow_supply_chain_smoke.py .",
    "check:graph": "node qa/p3_dependency_graph_smoke.mjs",
    "check:di": "node qa/p3_dependency_injection_smoke.mjs",
    "check:shell": "node qa/p3_shell_decomposition_smoke.mjs",
    "check:final": "node qa/p3_final_architecture_smoke.mjs",
    "check:p4": "python3 qa/p4_platform_hardening_smoke.py .",
    "check:p4:backend": "python3 qa/p4_backend_maintainability_smoke.py .",
    "build:css": "python3 tools/build_css.py",
    "check:p4:css": "python3 qa/p4_css_architecture_smoke.py .",
    "build:esm": "node tools/esbuild-production.mjs",
    "build:production": "npm run build:esm && python3 tools/fingerprint_assets.py --require-esbuild",
    "check:p4:i18n": "python3 qa/p4_i18n_semantic_smoke.py .",
    "check:p4:build": "python3 qa/p4_production_build_smoke.py .",
    "check:p5": "python3 qa/p5_audit_performance_smoke.py .",
    "check:release": "python3 qa/release_final_smoke.py .",
    "check:i18n-copy": "python3 qa/i18n_hardcoded_copy_smoke.py .",
    "check:services": "node qa/esm_service_publication_smoke.mjs",
    "checksums:update": "node tools/update-release-checksums.mjs",
    "checksums:verify": "node tools/verify-release-checksums.mjs",
    "build:release": "npm run build:production && npm run checksums:update",
    "check:provenance": "python3 qa/release_provenance_smoke.py .",
    "check:i18n-runtime": "python3 qa/i18n_runtime_literal_smoke.py .",
    "check:p2:release": "python3 qa/p2_release_quality_smoke.py .",
    "check:layout": "python3 qa/architecture_layout_smoke.py .",
    "check:maintenance": "python3 qa/maintenance_release_smoke.py .",
    "check:deploy-contract": "python3 qa/automatic_deploy_contract_smoke.py",
    "check:p6": "python3 qa/p6_production_ux_security_smoke.py .",
    "check:radar4": "php qa/radar4_shadow_smoke.php",
    "check:radar4:p32": "php qa/radar4_probabilistic_shadow_smoke.php",
    "check:radar4:p33": "php qa/radar4_empirical_calibration_smoke.php && python3 qa/radar4_empirical_calibration_schema_smoke.py",
    "check:radar4:p34": "php qa/radar4_promotion_study_smoke.php",
    "check:radar4:ops": "php qa/radar4_operational_readiness_smoke.php",
    "check:ai-v2": "php qa/ai_meteorologist_v2_smoke.php",
    "check:personal-twin": "php qa/personal_weather_twin_v2_smoke.php",
    "check:weather-observability": "php qa/weather_observability_release_smoke.php && python3 qa/roadmap_complete_schema_smoke.py",
    "check:roadmap-complete": "npm run check:ai-v2 && npm run check:personal-twin && npm run check:weather-observability && python3 qa/roadmap_contract_smoke.py",
    "qa:fast": "node tools/run-quality.mjs fast",
    "qa:release": "node tools/run-quality.mjs release",
    "qa:full": "npm run lint:eslint && npm run build:production && npm run check:ci-runtime && node tools/run-quality.mjs full",
    "build:reproducible": "python3 tools/reproducible-build.py --check-twice",
    "check:build-reproducibility": "python3 qa/build_reproducibility_smoke.py",
    "check:quality-trends": "python3 qa/quality_trends_contract_smoke.py",
    "check:property": "php qa/property_weather_invariants.php",
    "check:mutation": "python3 tools/mutation-runner.py",
    "check:weather-improvements": "php qa/metric_driven_weather_improvements_smoke.php",
    "check:radar-v2": "python3 qa/radar_layer_v2_smoke.py .",
    "check:architecture10": "python3 qa/architecture_10_10_smoke.py .",
    "check:zero-comments": "python3 qa/zero_comments_smoke.py .",
    "check:i18n-db": "python3 qa/i18n_db_source_smoke.py .",
    "check:app-shell": "python3 qa/app_shell_components_smoke.py .",
    "check:php-components": "python3 qa/php_helper_components_smoke.py .",
    "check:10-10": "python3 qa/roadmap_10_10_final_smoke.py .",
    "check:ci-runtime": "node tools/run-python.mjs qa/ci_runtime_parity_smoke.py"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "eslint": "10.10.0"
  }
}
