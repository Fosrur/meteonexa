# MySQL 8.4 container. Generate real values with ./docker/init-env.sh
MYSQL_DATABASE=meteonexa_staging
MYSQL_USER=meteonexa
MYSQL_PASSWORD=CHANGE_ME_APP_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_DB_PASSWORD

# URL pubblico definitivo della PWA.
METEONEXA_BASE_URL=https://staging.meteonexa.com/

# Same compose as production, isolated project/container/runtime state.
COMPOSE_PROJECT_NAME=meteonexa-staging
METEONEXA_DB_CONTAINER_NAME=meteonexa-staging-db
METEONEXA_WEB_CONTAINER_NAME=meteonexa-staging-web
METEONEXA_WORKER_CONTAINER_NAME=meteonexa-staging-worker
METEONEXA_RUNTIME_DIR=./runtime-staging

# Worker cadence. Worker stays idle until the installer has switched runtime to MySQL.
METEONEXA_WORKER_INTERVAL_SECONDS=180
# Cron/Web Push secrets. Generate independent long random values in production/staging.
METEONEXA_PIPELINE_CRON_SECRET=
METEONEXA_PUSH_CRON_SECRET=
METEONEXA_VAPID_SUBJECT=https://staging.meteonexa.com/

# Verified Trust / provider orchestration
METEONEXA_VERIFICATION_RETENTION_DAYS=180
METEONEXA_RUNTIME_METRICS_RETENTION_DAYS=30
METEONEXA_PRODUCT_METRICS_ENABLED=1
METEONEXA_PRODUCT_METRICS_RETENTION_DAYS=180
METEONEXA_PRODUCT_METRICS_MAX_GLOBAL_HOUR=6000

# Privacy-friendly traffic analytics (Plausible, no analytics cookies).
# The domain must also be configured as a site in your Plausible account.
METEONEXA_PLAUSIBLE_ENABLED=1
METEONEXA_PLAUSIBLE_DOMAIN=staging.meteonexa.com
METEONEXA_MINIMUM_TRUST_SAMPLES=20
METEONEXA_PROVIDER_PARALLEL=1
METEONEXA_PROVIDER_BUDGET_SECONDS=9
METEONEXA_PROVIDER_TIMEOUT_SECONDS=8
# off | shadow | active. Shadow calcola Radar 3.0 ma mantiene Radar 2.x autorevole.
METEONEXA_RADAR3_MODE=active

# Optional providers
METEONEXA_XWEATHER_CLIENT_ID=
METEONEXA_XWEATHER_CLIENT_SECRET=
METEONEXA_METEOALARM_EDR_TOKEN=
METEONEXA_SYNOP_OBSERVATION_URL=
METEONEXA_ARPA_OBSERVATION_URL=
METEONEXA_RADAR_FALLBACK_METADATA_URL=
METEONEXA_RADAR_ALLOWED_HOSTS=


# SMTP transazionale - profilo predisposto per Brevo SMTP Relay.
# Prima dell'uso: autentica meteonexa.com in Brevo e crea una CHIAVE SMTP.
# METEONEXA_SMTP_USERNAME = Login SMTP mostrato da Brevo (non necessariamente la tua email).
# METEONEXA_SMTP_PASSWORD = chiave SMTP Brevo (NON API key).
METEONEXA_SMTP_HOST=smtp-relay.brevo.com
METEONEXA_SMTP_PORT=587
METEONEXA_SMTP_ENCRYPTION=tls
METEONEXA_SMTP_USERNAME=
METEONEXA_SMTP_PASSWORD=
METEONEXA_SMTP_FROM_EMAIL=alerts@meteonexa.com
METEONEXA_SMTP_FROM_NAME=MeteoNexa
METEONEXA_SMTP_TIMEOUT_SECONDS=18

# Amministratori QA/Diagnostics espliciti (email separate da virgola/punto e virgola).
# Non usare l'identità SMTP come amministratore implicito.
METEONEXA_QA_ADMIN_EMAILS=

# Casella monitorata per le segnalazioni bug. Se vuota: privacy contact -> SMTP From.
METEONEXA_BUG_REPORT_EMAIL=
# Contatto pubblico Privacy/GDPR (può coincidere con il supporto).
METEONEXA_PRIVACY_CONTACT_EMAIL=
# Identità Art. 13 GDPR del titolare: obbligatoria prima di pubblicare un deployment production.
METEONEXA_LEGAL_CONTROLLER_NAME=
METEONEXA_LEGAL_CONTROLLER_ADDRESS=
# Stato DPO esplicito: appointed | not-appointed. Se appointed, l'email è obbligatoria.
METEONEXA_DPO_STATUS=not-appointed
METEONEXA_DPO_EMAIL=
METEONEXA_LEGAL_SITE_URL=https://staging.meteonexa.com/
